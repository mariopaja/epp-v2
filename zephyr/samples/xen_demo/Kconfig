# Parts of the epp-v2 Zephyr DomU demo, one source file each (src/,
# CMakeLists.txt). The devices Xen passes through are selected in Dom0
# (epp-passthrough); a part only runs when its device is passed through.

mainmenu "epp-v2 Zephyr DomU demo"

config EPP_LPI2C4
	bool "Display bus (LPI2C4, passthrough option lpi2c4)"
	default $(dt_nodelabel_enabled,lpi2c4)
	depends on $(dt_nodelabel_enabled,lpi2c4)
	help
	  Every 10 s: scan the display bus, read the IT6263 chip ID, write and
	  read back a PCA9632 register. On when the lpi2c4 node in app.overlay
	  is "okay" (disabled by default: the bus belongs to HDMI in Linux).

config EPP_LPI2C5
	bool "40-pin header I2C, pins 27/28 (LPI2C5, passthrough option lpi2c5)"
	default $(dt_nodelabel_enabled,lpi2c5)
	depends on $(dt_nodelabel_enabled,lpi2c5)
	help
	  Every 10 s: scan the bus. On when the lpi2c5 node in app.overlay is
	  "okay".

config EPP_LPI2C6
	bool "40-pin header I2C, pins 3/5 (LPI2C6, passthrough option lpi2c6)"
	default $(dt_nodelabel_enabled,lpi2c6)
	depends on $(dt_nodelabel_enabled,lpi2c6)
	help
	  Every 10 s: scan the bus. On when the lpi2c6 node in app.overlay is
	  "okay".

config EPP_LPI2C7
	bool "40-pin header I2C, pins 31/26 (LPI2C7, passthrough option lpi2c7)"
	default $(dt_nodelabel_enabled,lpi2c7)
	depends on $(dt_nodelabel_enabled,lpi2c7)
	help
	  Every 10 s: scan the bus. On when the lpi2c7 node in app.overlay is
	  "okay".

config EPP_LPSPI7
	bool "40-pin header SPI (LPSPI7, passthrough option lpspi7)"
	default $(dt_nodelabel_enabled,lpspi7)
	depends on $(dt_nodelabel_enabled,lpspi7)
	select SPI
	help
	  Every 10 s: loopback test without chip select (connect MOSI pin 31
	  to MISO pin 29 with a jumper). On when the lpspi7 node in
	  app.overlay is "okay".

config EPP_W5500
	bool "W5500 register test on the header SPI"
	depends on EPP_LPSPI7
	help
	  Every 10 s: read the version (0x04) and PHY state of a WIZnet W5500
	  on LPSPI7 and write and read back its MAC address register. Set by
	  w5500.conf, together with w5500.overlay (the w5500 node).

config EPP_W5500_ETH
	bool "W5500 as second network interface (Zephyr's W5500 driver)"
	depends on EPP_LPSPI7 && !EPP_W5500
	help
	  A WIZnet W5500 on LPSPI7 with Zephyr's Ethernet driver: DHCP on it
	  and its state every 10 s, next to netfront. LPSPI7 then starts at
	  boot: lpspi7 must be passed through and its pins set by U-Boot.
	  Set by extras/w5500-eth.conf, together with
	  extras/w5500-eth.overlay.

config EPP_SPI_LOOPBACK
	bool
	default y
	depends on EPP_LPSPI7 && !EPP_W5500 && !EPP_W5500_ETH
	help
	  The header SPI part without a W5500: loopback test.

config EPP_FLEXCAN2
	bool "CAN2 (FlexCAN2, connector J20, passthrough option flexcan2)"
	default $(dt_nodelabel_enabled,flexcan2)
	depends on $(dt_nodelabel_enabled,flexcan2)
	select CAN
	help
	  CAN at 500 kbit/s: a heartbeat frame 0x123 every second (counter),
	  frames with ID 0x100 are answered with the same data on ID 0x101.
	  Every 10 s the state and counters. On when the flexcan2 node in
	  app.overlay is "okay".

config EPP_FLEXCAN2_LOOPBACK
	bool "CAN2 in loopback mode (no bus needed)"
	depends on EPP_FLEXCAN2
	help
	  Start FlexCAN2 in loopback mode: it receives its own frames
	  internally, without transceiver and bus. Every 10 s the application
	  also sends a request (0x100), so its answer (0x101) is received as
	  well. Set by extras/can-loopback.conf.

config EPP_LPUART7
	bool "40-pin header UART (LPUART7, passthrough option lpuart7)"
	default $(dt_nodelabel_enabled,lpuart7)
	depends on $(dt_nodelabel_enabled,lpuart7)
	select SERIAL
	help
	  Every 10 s: a loopback test at 115200 baud (connect TX pin 24 to RX
	  pin 21 with a wire). On when the lpuart7 node in app.overlay is
	  "okay".

config EPP_PCF8574
	bool "PCF8574 I/O expander module on the header I2C"
	depends on EPP_LPI2C6
	help
	  Drive the pins P0-P7 of a PCF8574 module at 0x20 (not on the board)
	  as GPIOs: one pin high after the other, then all high, then all
	  low, every step read back. Set by extras/pcf8574.conf, together with
	  extras/pcf8574.overlay (the pcf8574 and zephyr,user nodes).

source "Kconfig.zephyr"
