/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Optional test device, not on the board: a PCF8574 I/O expander module on
 * the 40-pin header (VCC pin 1 3.3 V, GND pin 6, SDA pin 3, SCL pin 5) at
 * 0x20 (A0-A2 to GND; a PCF8574A is at 0x38), its pins P0-P7 driven as
 * GPIOs of the application (with the lpi2c6 passthrough). Add with
 * -DEXTRA_DTC_OVERLAY_FILE=...;pcf8574.overlay
 * -DEXTRA_CONF_FILE=...;pcf8574.conf (preset header-pcf8574).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

&lpi2c6 {
	/* Started by the application after the bus, like the bus itself */
	pcf8574: gpio@20 {
		compatible = "nxp,pcf857x";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		zephyr,deferred-init;
	};
};

/ {
	zephyr,user {
		pcf8574-gpios = <&pcf8574 0 GPIO_ACTIVE_HIGH>, <&pcf8574 1 GPIO_ACTIVE_HIGH>,
				<&pcf8574 2 GPIO_ACTIVE_HIGH>, <&pcf8574 3 GPIO_ACTIVE_HIGH>,
				<&pcf8574 4 GPIO_ACTIVE_HIGH>, <&pcf8574 5 GPIO_ACTIVE_HIGH>,
				<&pcf8574 6 GPIO_ACTIVE_HIGH>, <&pcf8574 7 GPIO_ACTIVE_HIGH>;
	};
};
