/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Devices Xen can pass through to this DomU, at their physical addresses:
 * GPIO2 with the FRDM-IMX95 RGB LED D19 (green GPIO_IO04, blue GPIO_IO12,
 * red GPIO_IO13, active high), always; and one of LPI2C4 (display bus) or
 * LPI2C6 (40-pin header J19, pin 3 SDA, pin 5 SCL), selected in Dom0 with
 * epp-passthrough. Accessing a device that is not passed through aborts, so
 * the I2C buses are not initialized at boot (zephyr,deferred-init): the
 * application starts the one Dom0 lists in xenstore (epp/passthrough).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	gpio2: gpio@43810000 {
		compatible = "epp,xen-rgpio";
		reg = <0x00 0x43810000 0x00 0x1000>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	/*
	 * Display bus: IT6263 HDMI bridge (0x4c, 0x33), PCA9632 (0x62). It
	 * belongs to HDMI in Linux, so it is disabled here: set "okay" to
	 * compile in its test (CONFIG_EPP_LPI2C4 follows this status) and
	 * select lpi2c4 with epp-passthrough in Dom0.
	 */
	lpi2c4: i2c@42540000 {
		compatible = "epp,xen-lpi2c";
		reg = <0x00 0x42540000 0x00 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		zephyr,deferred-init;
		status = "disabled";
	};

	lpi2c6: i2c@426c0000 {
		compatible = "epp,xen-lpi2c";
		reg = <0x00 0x426c0000 0x00 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		zephyr,deferred-init;
		status = "okay";

		/*
		 * Optional test device, not on the board: a PCF8574 I/O expander
		 * module on the header (VCC pin 1 3.3 V, GND pin 6, SDA pin 3,
		 * SCL pin 5) at 0x20 (A0-A2 to GND; a PCF8574A is at 0x38).
		 * Uncomment this node, the zephyr,user node below and
		 * CONFIG_EPP_PCF8574 in prj.conf to drive its pins P0-P7 as
		 * GPIOs (with the lpi2c6 passthrough). Like the bus, it is
		 * started by the application.
		 *
		 * pcf8574: gpio@20 {
		 *	compatible = "nxp,pcf857x";
		 *	reg = <0x20>;
		 *	gpio-controller;
		 *	#gpio-cells = <2>;
		 *	ngpios = <8>;
		 *	zephyr,deferred-init;
		 * };
		 */
	};

	/*
	 * The PCF8574 pins P0-P7 as GPIOs of the application (with the
	 * pcf8574 node above):
	 *
	 * zephyr,user {
	 *	pcf8574-gpios = <&pcf8574 0 GPIO_ACTIVE_HIGH>, <&pcf8574 1 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 2 GPIO_ACTIVE_HIGH>, <&pcf8574 3 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 4 GPIO_ACTIVE_HIGH>, <&pcf8574 5 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 6 GPIO_ACTIVE_HIGH>, <&pcf8574 7 GPIO_ACTIVE_HIGH>;
	 * };
	 */

	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&gpio2 13 GPIO_ACTIVE_HIGH>;
			label = "D19 red";
		};

		led_green: led_green {
			gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
			label = "D19 green";
		};

		led_blue: led_blue {
			gpios = <&gpio2 12 GPIO_ACTIVE_HIGH>;
			label = "D19 blue";
		};
	};
};
