/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Devices passed through by Xen to this DomU at their physical addresses
 * (EPP_XEN_ZEPHYR_PASSTHROUGH="gpio2 lpi2c6" in epp-v2 board.conf): GPIO2
 * with the FRDM-IMX95 RGB LED D19 (green GPIO_IO04, blue GPIO_IO12, red
 * GPIO_IO13, active high) and LPI2C6 on the 40-pin header J19 (pin 3 SDA,
 * pin 5 SCL).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	gpio2: gpio@43810000 {
		compatible = "epp,xen-rgpio";
		reg = <0x00 0x43810000 0x00 0x1000>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	lpi2c6: i2c@426c0000 {
		compatible = "epp,xen-lpi2c";
		reg = <0x00 0x426c0000 0x00 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "okay";

		/*
		 * Optional test device, not on the board: a PCF8574 I/O expander
		 * module on the header (VCC pin 1 3.3 V, GND pin 6, SDA pin 3,
		 * SCL pin 5) at 0x20 (A0-A2 to GND; a PCF8574A is at 0x38).
		 * Uncomment this node, the zephyr,user node below and
		 * CONFIG_GPIO_PCF857X_INIT_PRIORITY in prj.conf to drive its pins
		 * P0-P7 as GPIOs.
		 *
		 * pcf8574: gpio@20 {
		 *	compatible = "nxp,pcf857x";
		 *	reg = <0x20>;
		 *	gpio-controller;
		 *	#gpio-cells = <2>;
		 *	ngpios = <8>;
		 * };
		 */
	};

	/*
	 * The PCF8574 pins P0-P7 as GPIOs of the application (with the
	 * pcf8574 node above):
	 *
	 * zephyr,user {
	 *	pcf8574-gpios = <&pcf8574 0 GPIO_ACTIVE_HIGH>, <&pcf8574 1 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 2 GPIO_ACTIVE_HIGH>, <&pcf8574 3 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 4 GPIO_ACTIVE_HIGH>, <&pcf8574 5 GPIO_ACTIVE_HIGH>,
	 *			<&pcf8574 6 GPIO_ACTIVE_HIGH>, <&pcf8574 7 GPIO_ACTIVE_HIGH>;
	 * };
	 */

	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&gpio2 13 GPIO_ACTIVE_HIGH>;
			label = "D19 red";
		};

		led_green: led_green {
			gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
			label = "D19 green";
		};

		led_blue: led_blue {
			gpios = <&gpio2 12 GPIO_ACTIVE_HIGH>;
			label = "D19 blue";
		};
	};
};
