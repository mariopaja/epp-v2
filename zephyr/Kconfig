menu "epp-v2"

config EPP_XEN_XENSTORE
	bool "Xenstore client for a Xen DomU"
	depends on XEN && !XEN_DOM0
	help
	  Xenstore client for a Zephyr DomU (read, write, directory) over the
	  xenstore ring page and event channel Xen provides to the domain. For
	  dom0less domains the domain needs "xen,enhanced"; the client waits
	  until Dom0 (init-dom0less) has set up the xenstore page.

config EPP_XEN_NETFRONT
	bool "Xen PV network frontend (netfront) for a Xen DomU"
	depends on NETWORKING && EPP_XEN_XENSTORE
	select NET_L2_ETHERNET
	help
	  Ethernet interface on the Xen vif Dom0 attaches to the domain
	  (xl network-attach), e.g. bridged to the physical network in Dom0.
	  One queue, one page per packet, rx-copy.

if EPP_XEN_NETFRONT

config EPP_XEN_NETFRONT_RX_BUFS
	int "Receive buffers (pages)"
	default 32

config EPP_XEN_NETFRONT_TX_BUFS
	int "Transmit buffers (pages)"
	default 16

config EPP_XEN_NETFRONT_XENSTORE_TIMEOUT
	int "Seconds to wait for xenstore"
	default 300

config EPP_XEN_NETFRONT_THREAD_STACK_SIZE
	int "Netfront thread stack size"
	default 2048

config EPP_XEN_NETFRONT_THREAD_PRIORITY
	int "Netfront thread priority"
	default 2

module = EPP_XEN_NETFRONT
module-str = Xen netfront
source "subsys/logging/Kconfig.template.log_config"

endif # EPP_XEN_NETFRONT

config EPP_XEN_RGPIO
	bool "NXP RGPIO passed through to a Xen DomU"
	default y
	depends on GPIO && DT_HAS_EPP_XEN_RGPIO_ENABLED
	help
	  Minimal driver for an RGPIO controller Xen passes through to the DomU
	  (compatible "epp,xen-rgpio"): no SCMI and no pinctrl, the System
	  Manager and Dom0 set those up. No interrupts.

endmenu
