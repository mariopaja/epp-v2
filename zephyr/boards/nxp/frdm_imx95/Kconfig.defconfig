# Same as imx95_evk_15x15.

if SOC_MIMX9596_A55

# GIC ITS depends on kernel heap which init priority is 30, so set
# GIC to be 31, mailbox and SCMI will be initialized by the order
# according to dts dependency although they use the same init priority.
configdefault INTC_INIT_PRIORITY
	default 31

configdefault MBOX_INIT_PRIORITY
	default 31

configdefault ARM_SCMI_SHMEM_INIT_PRIORITY
	default 31

configdefault ARM_SCMI_TRANSPORT_INIT_PRIORITY
	default 31

configdefault CLOCK_CONTROL_INIT_PRIORITY
	default 31

endif # SOC_MIMX9596_A55
