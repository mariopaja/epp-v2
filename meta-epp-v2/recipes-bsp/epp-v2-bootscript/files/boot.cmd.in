# epp-v2 U-Boot boot script (compiled to boot.scr).
# Loads the kernel and base DTB from the boot partition, applies the device
# tree overlays from overlays/ and boots, either Linux directly or under Xen.
# If anything fails, the script returns and U-Boot falls back to its default
# BSP boot command.
#
# epp_xen (set at build time by ./docker-run.sh --xen=<mode>):
#   no        Linux, no Xen
#   dom0      Xen, Linux from partition 2 as Dom0
#   domu      Xen, minimal Dom0 from partition 2; Dom0 starts the DomU
#   dom0less  Xen, minimal Dom0 from partition 2 and the DomU (rootfs on
#             partition 3) created by Xen at boot from /chosen/domU1; with
#             EPP_XEN_ZEPHYR_IMAGE also a Zephyr DomU (/chosen/domU2) from
#             zephyr-domu.bin
#
# Override at the U-Boot prompt (then 'saveenv'):
#   setenv epp_overlays "foo.dtbo bar.dtbo"
#   setenv epp_fdtfile imx95-15x15-frdm.dtb
#   setenv epp_xen no                 # boot partition 2 without Xen
#   setenv epp_xen_bootargs "..."     # Xen command line

echo "epp-v2: boot script"

# bootstd sets devtype/devnum/distro_bootpart; fall back to the BSP env.
if test -n "${devtype}"; then
    setenv epp_devtype ${devtype}
    setenv epp_devpart ${devnum}:${distro_bootpart}
else
    setenv epp_devtype mmc
    setenv epp_devpart ${mmcdev}:${mmcpart}
fi

if test -z "${epp_overlays}"; then
    setenv epp_overlays "@@EPP_OVERLAYS@@"
fi
if test -z "${epp_fdtfile}"; then
    setenv epp_fdtfile "@@EPP_FDTFILE@@"
fi
if test -z "${epp_xen}"; then
    setenv epp_xen "@@EPP_XEN@@"
fi
if test -z "${epp_xen_bootargs}"; then
    setenv epp_xen_bootargs "console=dtuart dom0_mem=@@EPP_DOM0_MEM@@M dom0_max_vcpus=@@EPP_DOM0_VCPUS@@ pci-passthrough=on"
fi
if test -z "${fdtoverlay_addr_r}"; then
    setenv fdtoverlay_addr_r 0x93200000
fi
if test -z "${xenlinux_addr}"; then
    setenv xenlinux_addr 0x9c000000
fi
# DomU kernel above the reserved-memory regions vpu_boot@a0000000 and
# ele-reserved@a4120000 of the FRDM device tree (Xen panics on overlaps)
if test -z "${epp_domu_kernel_addr}"; then
    setenv epp_domu_kernel_addr 0xa4400000
fi
if test -z "${epp_zephyr_domu}"; then
    setenv epp_zephyr_domu "@@EPP_XEN_ZEPHYR@@"
fi
if test -z "${epp_zephyr_pt_path}"; then
    setenv epp_zephyr_pt_path "@@EPP_XEN_ZEPHYR_PT_PATH@@"
fi
# Partial device tree for the Zephyr DomU passthrough, after its kernel
if test -z "${epp_zephyr_pt_addr}"; then
    setenv epp_zephyr_pt_addr 0xa9000000
fi
if test -z "${epp_zephyr_cpu_node}"; then
    setenv epp_zephyr_cpu_node "@@EPP_XEN_ZEPHYR_CPU_NODE@@"
fi
# Zephyr DomU image above the Linux DomU kernel
if test -z "${epp_zephyr_addr}"; then
    setenv epp_zephyr_addr 0xa8000000
fi

# Xen goes to ${loadaddr}, the Dom0 kernel to ${xenlinux_addr} (same layout
# as the BSP 'xenmmcboot' command), the dom0less DomU kernel to
# ${epp_domu_kernel_addr}.
setenv epp_kernel_addr ${loadaddr}
if test "${epp_xen}" != "no"; then
    if load ${epp_devtype} ${epp_devpart} ${loadaddr} xen; then
        echo "epp-v2: booting Xen (${epp_xen})"
        setenv epp_kernel_addr ${xenlinux_addr}
        setenv console "hvc0 earlycon=xen"
        setenv jh_clk "kvm.enable_virt_at_load=false clk_ignore_unused"
    else
        echo "epp-v2: WARNING xen not found, booting Linux without Xen"
        setenv epp_xen no
    fi
fi

run mmcargs

if load ${epp_devtype} ${epp_devpart} ${epp_kernel_addr} ${image}; then
    setenv epp_kernel_size ${filesize}
    if test "${epp_xen}" = "dom0less"; then
        if load ${epp_devtype} ${epp_devpart} ${epp_domu_kernel_addr} ${image}; then
            setenv epp_domu_kernel_size ${filesize}
        else
            echo "epp-v2: WARNING DomU kernel not loaded, booting Xen with Dom0 only"
            setenv epp_xen domu
        fi
    fi
    if test "${epp_xen}" = "dom0less" && test "${epp_zephyr_domu}" = "yes"; then
        if load ${epp_devtype} ${epp_devpart} ${epp_zephyr_addr} zephyr-domu.bin; then
            setenv epp_zephyr_size ${filesize}
            if test -n "${epp_zephyr_pt_path}"; then
                if load ${epp_devtype} ${epp_devpart} ${epp_zephyr_pt_addr} zephyr-domu-pt.dtb; then
                    setenv epp_zephyr_pt_size ${filesize}
                else
                    echo "epp-v2: WARNING zephyr-domu-pt.dtb not found, no passthrough"
                    setenv epp_zephyr_pt_path ""
                fi
            fi
        else
            echo "epp-v2: WARNING zephyr-domu.bin not found, no Zephyr DomU"
            setenv epp_zephyr_domu no
        fi
    fi
    if load ${epp_devtype} ${epp_devpart} ${fdt_addr_r} ${epp_fdtfile}; then
        fdt addr ${fdt_addr_r}
        fdt resize 0x20000
        for ov in ${epp_overlays}; do
            echo "epp-v2: applying overlay ${ov}"
            if load ${epp_devtype} ${epp_devpart} ${fdtoverlay_addr_r} overlays/${ov}; then
                fdt apply ${fdtoverlay_addr_r}
            else
                echo "epp-v2: WARNING overlay ${ov} not found"
            fi
        done
        # dom0less DomUs in Xen's numbering order (domain 1, 2, ...), passed to
        # Dom0 as epp.domus= for epp-v2-dom0less-setup, which names them and
        # attaches their devices. Must match the node order created below:
        # the Linux DomU node is created last, so it is domain 1.
        setenv epp_domus ""
        if test "${epp_xen}" = "dom0less"; then
            setenv epp_domus "epp.domus=linux"
            if test "${epp_zephyr_domu}" = "yes"; then
                setenv epp_domus "epp.domus=linux,zephyr"
            fi
        fi
        if test "${epp_xen}" != "no"; then
            # Pass the kernel to Xen as Dom0 module; Xen owns the SMMU
            fdt mknode /chosen module@0
            fdt set /chosen/module@0 compatible "xen,linux-zimage" "xen,multiboot-module"
            fdt set /chosen/module@0 reg <0x00000000 ${epp_kernel_addr} 0x00000000 0x${epp_kernel_size}>
            fdt set /chosen/module@0 bootargs "${bootargs} ${xenlinux_bootargs} ${epp_domus}"
            fdt set /soc/bus@49000000/iommu@490d0000 status disabled
        fi
        # Xen numbers dom0less domains in /chosen order, and fdt mknode puts
        # a new node first: create domU2 (Zephyr) before domU1 so that the
        # epp-v2 Linux DomU is domain 1 (epp-v2-dom0less.service attaches
        # its disk and network to domain 1) and Zephyr domain 2.
        if test "${epp_xen}" = "dom0less" && test "${epp_zephyr_domu}" = "yes"; then
            # Zephyr (xenvm) DomU: console on the emulated PL011; xenstore
            # (xen,enhanced) set up by init-dom0less in Dom0, for Xen PV
            # devices such as the network frontend
            echo "epp-v2: dom0less Zephyr DomU: @@EPP_XEN_ZEPHYR_VCPUS@@ vCPU, @@EPP_XEN_ZEPHYR_MEM@@ MB"
            fdt mknode /chosen domU2
            fdt set /chosen/domU2 compatible "xen,domain"
            fdt set /chosen/domU2 "#address-cells" <2>
            fdt set /chosen/domU2 "#size-cells" <2>
            fdt set /chosen/domU2 memory <0x0 @@EPP_XEN_ZEPHYR_MEM_KB@@>
            fdt set /chosen/domU2 cpus <@@EPP_XEN_ZEPHYR_VCPUS@@>
            fdt set /chosen/domU2 vpl011
            fdt set /chosen/domU2 xen,enhanced "enabled"
            # Dedicated core: own cpupool with the null scheduler (needs Xen
            # with BOOT_TIME_CPUPOOLS). The other cores form Pool-0.
            if test -n "${epp_zephyr_cpu_node}"; then
                if fdt get value epp_zephyr_cpu_ph ${epp_zephyr_cpu_node} phandle; then
                    echo "epp-v2: Zephyr DomU on its own core (${epp_zephyr_cpu_node})"
                    fdt mknode /chosen epp-cpupool-zephyr
                    fdt set /chosen/epp-cpupool-zephyr compatible "xen,cpupool"
                    fdt set /chosen/epp-cpupool-zephyr cpupool-cpus <${epp_zephyr_cpu_ph}>
                    fdt set /chosen/epp-cpupool-zephyr cpupool-sched "null"
                    fdt set /chosen/epp-cpupool-zephyr phandle <0xe99e0001>
                    fdt set /chosen/domU2 domain-cpupool <0xe99e0001>
                else
                    echo "epp-v2: WARNING ${epp_zephyr_cpu_node} not found, Zephyr DomU shares the cores"
                fi
            fi
            fdt mknode /chosen/domU2 module@0
            fdt set /chosen/domU2/module@0 compatible "multiboot,kernel" "multiboot,module"
            fdt set /chosen/domU2/module@0 reg <0x0 ${epp_zephyr_addr} 0x0 0x${epp_zephyr_size}>
            # Hardware passthrough: Xen takes the device away from Dom0
            # (status disabled there) and maps it into this domain as
            # described by the partial device tree
            if test -n "${epp_zephyr_pt_path}"; then
                echo "epp-v2: passing ${epp_zephyr_pt_path} through to the Zephyr DomU"
                fdt set ${epp_zephyr_pt_path} xen,passthrough
                fdt mknode /chosen/domU2 module@1
                fdt set /chosen/domU2/module@1 compatible "multiboot,device-tree" "multiboot,module"
                fdt set /chosen/domU2/module@1 reg <0x0 ${epp_zephyr_pt_addr} 0x0 0x${epp_zephyr_pt_size}>
            fi
        fi
        if test "${epp_xen}" = "dom0less"; then
            # DomU created by Xen at boot. Console on the emulated PL011
            # (switch Xen consoles with Ctrl-a three times); disk and network
            # are attached by Dom0 (epp-v2-dom0less.service).
            echo "epp-v2: dom0less DomU: @@EPP_DOMU_VCPUS@@ vCPUs, @@EPP_DOMU_MEM@@ MB"
            fdt mknode /chosen domU1
            fdt set /chosen/domU1 compatible "xen,domain"
            fdt set /chosen/domU1 "#address-cells" <2>
            fdt set /chosen/domU1 "#size-cells" <2>
            fdt set /chosen/domU1 memory <0x0 @@EPP_DOMU_MEM_KB@@>
            fdt set /chosen/domU1 cpus <@@EPP_DOMU_VCPUS@@>
            fdt set /chosen/domU1 vpl011
            fdt set /chosen/domU1 xen,enhanced "enabled"
            fdt mknode /chosen/domU1 module@0
            fdt set /chosen/domU1/module@0 compatible "multiboot,kernel" "multiboot,module"
            fdt set /chosen/domU1/module@0 reg <0x0 ${epp_domu_kernel_addr} 0x0 0x${epp_domu_kernel_size}>
            fdt set /chosen/domU1/module@0 bootargs "console=ttyAMA0 root=/dev/xvda rw rootwait"
        fi
        if test "${epp_xen}" != "no"; then
            setenv bootargs ${epp_xen_bootargs}
        fi
        booti ${loadaddr} - ${fdt_addr_r}
    fi
fi

echo "epp-v2: boot script failed, falling back to default boot"
