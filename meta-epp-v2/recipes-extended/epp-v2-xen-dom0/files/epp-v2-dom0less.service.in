# --xen=dom0less: Xen started the epp-v2 Linux DomU and, with
# EPP_XEN_ZEPHYR_IMAGE, the Zephyr DomU at boot, before Dom0. Set up their
# xenstore, name them and give them their disk and network from Dom0
# (epp-v2-dom0less-setup, domain order from epp.domus= on the command line).
[Unit]
Description=epp-v2: connect the dom0less DomU (xenstore, disk, network)
Requires=xenstored.service
After=xenstored.service xenconsoled.service xen-init-dom0.service systemd-networkd.service systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/libexec/epp-v2-wait-xenbr0
ExecStart=/usr/libexec/epp-v2-dom0less-setup

[Install]
WantedBy=multi-user.target
