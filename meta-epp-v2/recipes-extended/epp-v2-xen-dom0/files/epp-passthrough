#!/bin/sh
# Select the hardware Xen passes through to the Zephyr DomU at the next
# boot: the fixed devices (GPIO2) always, plus any of the options. Writes
# epp-passthrough.txt to the boot partition, which boot.scr reads.
#
#   epp-passthrough                     menu
#   epp-passthrough <option> [...]      select these options (lpi2c5 lpi2c6 ...)
#   epp-passthrough none                no option
#   epp-passthrough -l                  show the options and the selection

LIST=/usr/share/epp-v2/zephyr-passthrough.list
FILE=epp-passthrough.txt

die() { echo "epp-passthrough: $*" >&2; exit 1; }
[ -r "$LIST" ] || die "$LIST missing"

names() { grep "^$1:" "$LIST" | cut -d: -f2 | tr '\n' ' '; }
options=$(names option)
fixed=$(names fixed)
default=$(grep '^default:' "$LIST" | cut -d: -f2)
desc() { grep -E "^(fixed|option):$1:" "$LIST" | cut -d: -f3-; }
valid() { for o in $options; do [ "$o" = "$1" ] && return 0; done; return 1; }
# The option of $2 (a list) that conflicts with option $1 (shared pins), if any
conflict_with() {
    for c in $(grep '^conflict:' "$LIST" | cut -d: -f2-); do
        a=${c%:*}; b=${c#*:}
        for o in $2; do
            if { [ "$1" = "$a" ] && [ "$o" = "$b" ]; } || { [ "$1" = "$b" ] && [ "$o" = "$a" ]; }; then
                echo "$o"; return
            fi
        done
    done
}

# A selection is stored as the combination name boot.scr knows: the options
# in list order joined with "_", or "none"
combo() {
    c=""
    for o in $options; do
        case " $* " in *" $o "*) c="${c:+${c}_}$o" ;; esac
    done
    echo "${c:-none}"
}
# Options of a combination name, space separated
split() { [ "$1" = none ] || echo "$1" | tr _ ' '; }

# Boot partition: partition 1 of the disk Dom0 runs from
root=$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline)
bootdev=${root%[0-9]*}1
[ -b "$bootdev" ] || die "boot partition $bootdev not found"

with_boot() {   # with_boot <command...>: run with the boot partition on $mnt
    mnt=$(mktemp -d) || die "mktemp failed"
    mount "$bootdev" "$mnt" || { rmdir "$mnt"; die "cannot mount $bootdev"; }
    "$@"
    ret=$?
    umount "$mnt"
    rmdir "$mnt"
    return $ret
}

read_selected() {
    selected=$(sed -n 's/^epp_zephyr_pt=\(.*\)/\1/p' "$mnt/$FILE" 2>/dev/null)
    [ -n "$selected" ] || selected=$default
}
write_selected() {
    printf 'epp_zephyr_pt=%s\n' "$1" > "$mnt/$FILE" && sync
}

active=$(sed -n 's/.*epp\.passthrough=\([^ ]*\).*/\1/p' /proc/cmdline)

show() {   # show <selected options>
    echo "Xen passthrough to the Zephyr DomU"
    echo
    for f in $fixed; do printf '         always  %-8s %s\n' "$f" "$(desc "$f")"; done
    echo
    i=1
    for o in $options; do
        mark=" "
        case " $* " in *" $o "*) mark="x" ;; esac
        printf '  %d  [%s]          %-8s %s\n' "$i" "$mark" "$o" "$(desc "$o")"
        i=$((i + 1))
    done
    echo
    echo "  running now: ${active:-unknown}"
}

case "$1" in
    -h|--help)
        sed -n '2,10s/^# \{0,1\}//p' "$0"
        exit 0 ;;
    -l)
        with_boot read_selected
        show $(split "$selected")
        echo "  next boot:   gpio2 $(split "$selected")"
        exit 0 ;;
    "") ;;
    *)
        if [ "$*" != none ]; then
            for o in "$@"; do
                valid "$o" || die "unknown option '$o' ($options)"
                c=$(conflict_with "$o" "$*")
                [ -z "$c" ] || die "$o and $c use the same pins, select only one"
            done
        fi
        c=$(combo "$@")
        with_boot write_selected "$c" || die "cannot write $FILE"
        echo "Selected gpio2 $(split "$c") for the next boot (reboot to apply)."
        exit 0 ;;
esac

# Menu: toggle options by number
with_boot read_selected
choice=$(split "$selected")
n=$(echo $options | wc -w)
while true; do
    echo
    show $choice
    echo
    printf 'Toggle 1-%d, s to save, q to quit: ' "$n"
    read -r key || exit 1
    case "$key" in
        q) echo "Not changed."; exit 0 ;;
        s)
            c=$(combo $choice)
            with_boot write_selected "$c" || die "cannot write $FILE"
            echo "Saved: gpio2 $(split "$c") at the next boot."
            printf 'Reboot now? [y/N] '
            read -r yn
            [ "$yn" = y ] && reboot
            exit 0 ;;
        *[!0-9]*|"") ;;
        *)
            i=1
            for o in $options; do
                if [ "$i" = "$key" ]; then
                    case " $choice " in
                        *" $o "*) choice=$(echo " $choice " | sed "s/ $o / /") ;;
                        *)
                            c=$(conflict_with "$o" "$choice")
                            if [ -n "$c" ]; then
                                echo
                                echo "  $o and $c use the same pins: untick $c first"
                            else
                                choice="$choice $o"
                            fi ;;
                    esac
                fi
                i=$((i + 1))
            done ;;
    esac
done
